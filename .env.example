# 人情簿 Gift Ledger 环境变量配置
# 复制此文件为 .env 并修改相应配置

# ── 安全配置 ─────────────────────────────────────────────────
# JWT 签名密钥（务必修改为随机强密码！）
JWT_SECRET=gift_ledger_secret_key_change_me_in_production

# ── 网络配置 ─────────────────────────────────────────────────
# 前端对外暴露端口（默认 80）
HOST_PORT=80

# 允许跨域来源（生产环境应改为具体域名）
CORS_ORIGIN=*

# ── 数据库 ────────────────────────────────────────────────────
# SQLite 数据文件目录（容器内路径，已通过 Volume 持久化）
# 无需修改，由 Docker Volume 管理
