# 人情簿 Gift Ledger 环境变量配置
# 复制此文件为 .env 并修改相应配置

# ── 安全配置 ─────────────────────────────────────────────────
# JWT 签名密钥（必填，至少 32 位；可用 openssl rand -hex 32 生成）
JWT_SECRET=

# ── 网络配置 ─────────────────────────────────────────────────
# 宿主机 Nginx 的本地反向代理端口（仅绑定 127.0.0.1）
HOST_PORT=8090

# GHCR 镜像标签；生产默认跟随最新版
IMAGE_TAG=latest

# 同源部署保持为空；允许外部页面请求 API 时填写完整来源，多个以逗号分隔
CORS_ORIGIN=

# 单 IP 每 15 分钟最多认证请求次数
AUTH_RATE_LIMIT=100

# ── 数据库 ────────────────────────────────────────────────────
# SQLite 数据文件目录（容器内路径，已通过 Volume 持久化）
# 无需修改，由 Docker Volume 管理
